# Copie para .env e preencha os valores. Nunca commite o .env real.

# --- Autenticacao do dashboard ---
DATASENTINEL_ADMIN_USER=admin
DATASENTINEL_ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Sessao Flask ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
DATASENTINEL_SECRET_KEY=

# --- Token de servico usado pelo monitor.py para enviar alertas ao server.py ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
DATASENTINEL_INGEST_TOKEN=

# --- Rede (opcional) ---
# DATASENTINEL_HOST=127.0.0.1
# DATASENTINEL_PORT=5000
# DATASENTINEL_SERVER_URL=http://127.0.0.1:5000
# DATASENTINEL_ALLOWED_ORIGINS=https://meu-dominio.example.com
# DATASENTINEL_DEF_LAT=-23.55
# DATASENTINEL_DEF_LON=-46.63

# --- E-mail (alertas) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=
